{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(autocode unattended)",
      "Bash(autocode unattended *)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(autocode --*)",
      "Bash(autocode issue *)",
      "Bash(autocode components *)",
      "Bash(autocode arena *)",
      "Bash(autocode tasks *)",
      "Bash(autocode ui *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(git *)",
      "Bash(gocode *)",
      "Bash(codex *)",
      "Bash(opencode *)"
    ]
  }
}
