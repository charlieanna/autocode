{
  "name": "autocode-task-chat",
  "displayName": "AutoCode Task Chat",
  "description": "Drive AutoCode task runs from VS Code: start a run, follow its progress, and take the action the status view names.",
  "version": "0.1.0",
  "private": true,
  "publisher": "ankurkothari",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlieanna/autocode.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://charlieanna.github.io/autocode/latest/vscode/",
  "bugs": {
    "url": "https://github.com/charlieanna/autocode/issues"
  },
  "files": [
    "dist/extension.js",
    "media/icon.png",
    "media/autocode.svg",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autocode",
          "title": "AutoCode",
          "icon": "media/autocode.svg"
        }
      ]
    },
    "views": {
      "autocode": [
        {
          "id": "autocode.chat",
          "name": "Chat",
          "type": "webview",
          "when": "!autocode.showHistory",
          "contextualTitle": "AutoCode chat"
        },
        {
          "id": "autocode.runs",
          "name": "Runs",
          "when": "autocode.showHistory",
          "contextualTitle": "AutoCode runs"
        }
      ]
    },
    "commands": [
      {
        "command": "autocode.showChat",
        "title": "Back to Chat",
        "category": "AutoCode",
        "icon": "$(arrow-left)"
      },
      {
        "command": "autocode.startRun",
        "title": "New Chat",
        "category": "AutoCode",
        "icon": "$(plus)"
      },
      {
        "command": "autocode.refresh",
        "title": "Refresh Runs",
        "category": "AutoCode",
        "icon": "$(refresh)"
      },
      {
        "command": "autocode.openRun",
        "title": "Open Run",
        "category": "AutoCode"
      },
      {
        "command": "autocode.takeAction",
        "title": "Take the Named Action",
        "category": "AutoCode",
        "icon": "$(play)"
      },
      {
        "command": "autocode.continueRun",
        "title": "Continue Run",
        "category": "AutoCode",
        "icon": "$(debug-continue)"
      },
      {
        "command": "autocode.showCliCommand",
        "title": "Copy the Command the Status View Named",
        "category": "AutoCode",
        "icon": "$(clippy)"
      },
      {
        "command": "autocode.watchRun",
        "title": "Watch / Unwatch Run",
        "category": "AutoCode"
      },
      {
        "command": "autocode.showLog",
        "title": "Show AutoCode Output",
        "category": "AutoCode"
      },
      {
        "command": "autocode.openDetails",
        "title": "Open Run Details",
        "category": "AutoCode"
      },
      {
        "command": "autocode.connections",
        "title": "Connections",
        "category": "AutoCode",
        "icon": "$(plug)"
      },
      {
        "command": "autocode.stages",
        "title": "Stage Models",
        "category": "AutoCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "autocode.archiveRun",
        "title": "Archive Chat",
        "category": "AutoCode",
        "icon": "$(archive)"
      },
      {
        "command": "autocode.unarchiveRun",
        "title": "Unarchive Chat",
        "category": "AutoCode",
        "icon": "$(inbox)"
      },
      {
        "command": "autocode.deleteRun",
        "title": "Delete Chat",
        "category": "AutoCode",
        "icon": "$(trash)"
      },
      {
        "command": "autocode.toggleArchived",
        "title": "Archived Chats",
        "category": "AutoCode",
        "icon": "$(archive)"
      },
      {
        "command": "autocode.showBoard",
        "title": "Open Tasks Board",
        "category": "AutoCode",
        "icon": "$(checklist)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autocode.showBoard",
          "when": "view == autocode.runs",
          "group": "navigation@0"
        },
        {
          "command": "autocode.showChat",
          "when": "view == autocode.runs",
          "group": "navigation@0"
        },
        {
          "command": "autocode.startRun",
          "when": "view == autocode.runs",
          "group": "navigation@1"
        },
        {
          "command": "autocode.refresh",
          "when": "view == autocode.runs",
          "group": "navigation@2"
        },
        {
          "command": "autocode.toggleArchived",
          "when": "view == autocode.runs",
          "group": "navigation@3"
        },
        {
          "command": "autocode.showBoard",
          "when": "view == autocode.chat",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "autocode.continueRun",
          "when": "viewItem == autocode.runActive",
          "group": "inline@1"
        },
        {
          "command": "autocode.takeAction",
          "when": "viewItem == autocode.runNeeds",
          "group": "inline@1"
        },
        {
          "command": "autocode.archiveRun",
          "when": "viewItem == autocode.runNeeds",
          "group": "inline@2"
        },
        {
          "command": "autocode.archiveRun",
          "when": "viewItem == autocode.runStale",
          "group": "inline@2"
        },
        {
          "command": "autocode.unarchiveRun",
          "when": "viewItem == autocode.runArchived",
          "group": "inline@2"
        },
        {
          "command": "autocode.unarchiveRun",
          "when": "viewItem == autocode.runArchivedStale",
          "group": "inline@2"
        },
        {
          "command": "autocode.deleteRun",
          "when": "viewItem == autocode.runNeeds",
          "group": "inline@3"
        },
        {
          "command": "autocode.deleteRun",
          "when": "viewItem == autocode.runArchived",
          "group": "inline@3"
        },
        {
          "command": "autocode.archiveRun",
          "when": "viewItem == autocode.runNeeds",
          "group": "navigation@1"
        },
        {
          "command": "autocode.archiveRun",
          "when": "viewItem == autocode.runStale",
          "group": "navigation@1"
        },
        {
          "command": "autocode.unarchiveRun",
          "when": "viewItem == autocode.runArchived",
          "group": "navigation@1"
        },
        {
          "command": "autocode.unarchiveRun",
          "when": "viewItem == autocode.runArchivedStale",
          "group": "navigation@1"
        },
        {
          "command": "autocode.deleteRun",
          "when": "viewItem == autocode.runNeeds",
          "group": "navigation@2"
        },
        {
          "command": "autocode.deleteRun",
          "when": "viewItem == autocode.runArchived",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "AutoCode",
      "properties": {
        "autocode.cliPath": {
          "type": "string",
          "default": "autocode",
          "markdownDescription": "The `autocode` executable. Point it at a checkout wrapper if you run AutoCode from source."
        },
        "autocode.cliArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Leading arguments before AutoCode's own, for a `python3 /path/tools/autocode.py` style launch."
        },
        "autocode.provider": {
          "type": "string",
          "default": "",
          "markdownDescription": "Value for `--provider` for new chats. Existing chats keep their saved provider. Leave empty to use AutoCode's default. This is the route your models bill to, so check it before a live run."
        },
        "autocode.extraOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra engine and model flags for new chats, for example `[\"--engine\", \"codex\"]`."
        },
        "autocode.maxStageSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "markdownDescription": "Time limit for each step of a new chat, in seconds (`--max-stage-seconds`). Leave empty to use AutoCode's default (`3600`, or `max-stage-seconds` in `.autocode/config.toml`); `0` turns the limit off. A running chat keeps its own limit."
        },
        "autocode.pollSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "Seconds between `--status` reads for a watched run. Reads never change the checkpoint or launch a provider."
        },
        "autocode.confirmPersonOnly": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before resuming a run that stopped for your decision, or going on with a step that stopped. Keep this on: those are the decisions the run stopped to ask you."
        },
        "autocode.notify": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Notify when a run in an open chat tab starts waiting for you or finishes, with an action that opens its chat. Turn this off to stay silent while the sidebar keeps reading status."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "package": "vsce package --no-dependencies",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js test/*.test.cjs",
    "test:host": "node --test --test-concurrency=1 test/host/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "marked": "15.0.12"
  },
  "preview": true,
  "keywords": [
    "autocode",
    "agent",
    "planning",
    "code review",
    "tasks"
  ]
}
