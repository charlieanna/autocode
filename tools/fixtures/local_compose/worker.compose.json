{
  "services": {
    "mailer": {
      "build": {
        "context": "/TREE/components/mailer",
        "dockerfile_inline": "FROM python:3.12-slim\nWORKDIR /app\nCOPY . /app\n"
      },
      "command": [
        "/bin/sh",
        "-c",
        "python3 worker.py"
      ],
      "depends_on": {
        "store": {
          "condition": "service_started"
        }
      },
      "environment": {
        "MODE": "batch",
        "STORE_URL": "http://store:8001"
      },
      "healthcheck": {
        "interval": "1s",
        "retries": 120,
        "test": [
          "CMD",
          "python3",
          "check.py"
        ],
        "timeout": "5s"
      },
      "init": true,
      "mem_limit": "2g",
      "pids_limit": 1024,
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "store": {
      "build": {
        "context": "/TREE/components/store",
        "dockerfile": "Dockerfile"
      },
      "environment": {
        "PORT": "8001"
      },
      "init": true,
      "mem_limit": "2g",
      "pids_limit": 1024,
      "ports": [
        "127.0.0.1::8001"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "sweeper": {
      "build": {
        "context": "/TREE/components/sweeper",
        "dockerfile": "Dockerfile.worker"
      },
      "environment": {},
      "init": true,
      "mem_limit": "2g",
      "pids_limit": 1024,
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  }
}
