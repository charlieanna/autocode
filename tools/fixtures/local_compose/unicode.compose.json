{
  "services": {
    "api": {
      "build": {
        "context": "/TREE/tree-🚀/components/api",
        "dockerfile_inline": "FROM python:3.12-slim\nWORKDIR /app\nCOPY . /app\n"
      },
      "command": [
        "/bin/sh",
        "-c",
        "echo 😀 && python3 server.py"
      ],
      "environment": {
        "ACCENTED": "caf\u00e9 \u4f60",
        "C1": "\u0080",
        "GREETING": "hi 😀",
        "LOOKS_ESCAPED": "\\ud83d\\ude00 \\🚀",
        "NONCHARACTERS": "a\ufffeb\uffff",
        "PORT": "8000"
      },
      "init": true,
      "mem_limit": "2g",
      "pids_limit": 1024,
      "ports": [
        "127.0.0.1::8000"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "poller": {
      "build": {
        "context": "/TREE/tree-🚀/components/poller",
        "dockerfile_inline": "FROM python:3.12-slim\nWORKDIR /app\nCOPY . /app\n"
      },
      "command": [
        "/bin/sh",
        "-c",
        "python3 poll.py"
      ],
      "depends_on": {
        "api": {
          "condition": "service_started"
        }
      },
      "environment": {
        "API_URL": "http://api:8000"
      },
      "healthcheck": {
        "interval": "1s",
        "retries": 120,
        "test": [
          "CMD",
          "sh",
          "-c",
          "test -f /tmp/🚀"
        ],
        "timeout": "5s"
      },
      "init": true,
      "mem_limit": "2g",
      "pids_limit": 1024,
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  }
}
