{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocode.dev/schemas/evidence-report-v1.json",
  "title": "AutoCode completion evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "binding",
    "run",
    "provenance",
    "plan",
    "revision",
    "criteria",
    "checks",
    "regression_proof",
    "test_cases",
    "findings",
    "attempts",
    "usage",
    "unverified",
    "children",
    "workflow_result"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "program",
        "components",
        "verification"
      ]
    },
    "binding": {
      "type": "string"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "workflow",
        "completed_at",
        "turn",
        "started_at",
        "elapsed_seconds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn": {
          "type": [
            "integer",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "prompts_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "interaction_timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "launched_at",
            "first_question_at",
            "first_question_seconds",
            "first_plan_at",
            "first_plan_seconds",
            "first_builder_at",
            "first_builder_seconds"
          ],
          "properties": {
            "launched_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "first_question_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "first_question_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "first_plan_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "first_plan_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "first_builder_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "first_builder_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "basis",
        "declaration"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fake",
            "live",
            "mixed",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "declaration": {
          "type": "string"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_token",
        "criteria_revision",
        "task_id",
        "intended_outcome"
      ],
      "properties": {
        "contract_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "criteria_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "intended_outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_file": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "path",
            "goal_hash",
            "revision",
            "changed"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "goal_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "revision": {
              "type": "integer"
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "source_revision",
        "meaning"
      ],
      "properties": {
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "meaning": {
          "type": "string"
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "status",
          "validator_status",
          "evidence",
          "verification_method",
          "human_reviewed",
          "human_review",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "criterion": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "validator_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "human_reviewed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "human_review": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "evidence_refs": {
            "type": [
              "array",
              "null"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "output",
          "output_sha256",
          "purpose",
          "exit_code",
          "timed_out",
          "duration_seconds",
          "results"
        ],
        "properties": {
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timed_out": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "results": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "regression_proof": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "changed_code_evidence": {
          "description": "Source-bound completion gate, distinct from legacy advisory mutation summaries. Missing execution or mutation evidence leaves explicit obligations unless an independent Tester accepted the exact line reason.",
          "type": "object",
          "required": [
            "schema",
            "source_revision",
            "proof_context",
            "status",
            "reason",
            "obligations",
            "fallback"
          ],
          "properties": {
            "schema": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "source_revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "proof_context": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "UNVERIFIED"
              ]
            },
            "reason": {
              "type": "string"
            },
            "fallback": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "obligations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "gap_id",
                  "path",
                  "sha256",
                  "line",
                  "status",
                  "executed",
                  "mutation_demonstrated",
                  "mutation_outcomes",
                  "evidence",
                  "fallback",
                  "reason"
                ],
                "properties": {
                  "gap_id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "tested",
                      "reason_required",
                      "excepted"
                    ]
                  },
                  "executed": {
                    "type": "boolean"
                  },
                  "mutation_demonstrated": {
                    "type": "boolean"
                  },
                  "mutation_outcomes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "fallback": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "exception": {
                    "type": "object",
                    "required": [
                      "reason",
                      "evidence"
                    ],
                    "properties": {
                      "reason": {
                        "type": "string"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "reason_kind": {
                        "type": "string"
                      },
                      "reviewer": {
                        "type": "object",
                        "required": [
                          "stage",
                          "role",
                          "output"
                        ],
                        "properties": {
                          "stage": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string"
                          },
                          "output": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "stage",
          "engine",
          "model",
          "source_revision",
          "started_at",
          "finished_at",
          "role",
          "usage_basis",
          "runner_owned",
          "rejected",
          "interrupted",
          "timed_out",
          "request_coverage_complete",
          "duration_seconds",
          "reported_cost_usd",
          "historical_estimated_cost_usd",
          "exit_code",
          "tokens"
        ],
        "properties": {
          "identity": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "engine": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "runner_owned": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "rejected": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "interrupted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "timed_out": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "request_coverage_complete": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "reported_cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "historical_estimated_cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens": {
            "type": [
              "object",
              "null"
            ]
          },
          "prompts_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "provider_requests",
        "cost"
      ],
      "properties": {
        "tokens": {
          "type": [
            "object",
            "null"
          ]
        },
        "provider_requests": {
          "type": [
            "object",
            "null"
          ]
        },
        "cost": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "json_path",
          "json_sha256",
          "markdown_sha256",
          "source_revision",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "json_path": {
            "type": "string"
          },
          "json_sha256": {
            "type": "string"
          },
          "markdown_sha256": {
            "type": "string"
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "basis",
              "declaration"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "fake",
                  "live",
                  "mixed",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string"
              },
              "declaration": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "workflow_result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "outcome",
        "artifact",
        "artifact_sha256",
        "summary"
      ],
      "properties": {
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutation_check": {
          "type": [
            "object",
            "null"
          ]
        },
        "review_attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_existing",
            "inconclusive",
            "submitted_verdict",
            "verdict_adjustment"
          ],
          "properties": {
            "pre_existing": {
              "type": "integer",
              "minimum": 0
            },
            "inconclusive": {
              "type": "integer",
              "minimum": 0
            },
            "submitted_verdict": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "approve",
                "request_changes",
                null
              ]
            },
            "verdict_adjustment": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "source_revision": {
          "type": "string"
        }
      }
    },
    "approvals": {
      "description": "Who approved each plan and review, edited the plan, resumed the run from a pause or accepted its completion, oldest first, as the status view's approvals list them (#722). Recorded as given and never verified. Absent from reports written before AutoCode listed approvals, from the reports of workflows with no approval step (review, discuss), and from verification reports. A program or components report lists the approvals its child runs' own reports list, child by child, each naming its child; it is absent when none of those reports lists approvals.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "at",
          "actor",
          "contract_token",
          "criterion",
          "pause_status",
          "provenance"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "contract_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "criterion": {
            "type": [
              "string",
              "null"
            ]
          },
          "pause_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "description": "skip_to_build when the person chose, on starting the run, to approve the plan once the Plan Reviewer finalized it (#1731); otherwise null. Absent from reports written before AutoCode recorded it.",
            "type": [
              "string",
              "null"
            ]
          },
          "child": {
            "description": "Only in a program or components report: the id of the child run (as children lists it) whose own report lists this approval.",
            "type": "string"
          },
          "provenance": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "git_user_name",
              "git_user_email",
              "host",
              "command",
              "claimed_as"
            ],
            "properties": {
              "git_user_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "git_user_email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "command": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "claimed_as": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "changed_code_repairs": {
      "description": "Optional source-bound historical Builder/Investigator decisions, copied from the public verification view. Absent from legacy reports. History does not resolve current obligations.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "action",
          "source_revision",
          "review_output",
          "assessment"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "changed_code_rework"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "builder",
              "investigator"
            ]
          },
          "source_revision": {
            "type": "string"
          },
          "review_output": {
            "type": "string"
          },
          "assessment": {
            "type": "object"
          },
          "at": {
            "type": "string"
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "contract_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "contract_revision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "investigation": {
            "type": "object",
            "properties": {
              "diagnosis": {
                "type": "string"
              },
              "guidance": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "output": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
