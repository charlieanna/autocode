@@ -0,0 +1,15 @@
+import unittest
+
+from regclient.policies import POLICIES
+
+
+class AtPolicyTests(unittest.TestCase):
+    def test_at_allows_one_retry(self):
+        self.assertEqual(2, POLICIES["AT"].max_attempts)
+
+    def test_at_retries_only_server_busy(self):
+        self.assertEqual(("SERVER_BUSY",), POLICIES["AT"].retryable_errors)
+
+
+if __name__ == "__main__":
+    unittest.main()
